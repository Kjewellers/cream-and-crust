rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // Subscriptions
    match /subscriptions/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isAdmin(); 
    }

    // Products (Public read, Owner/Admin write)
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Orders (Public create, Owner/Admin read/update)
    match /orders/{orderId} {
      allow create: if true; 
      allow read: if true; // Allow public to see order status maybe? Or restrict to owner.
      // For now, let's allow read if it's the owner or admin
      // But for public order form, we might need to read the order back after creation.
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Customers (Owner/Admin read/write)
    match /customers/{customerId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Shopping List
    match /shoppingList/{itemId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Recipes
    match /recipes/{recipeId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Business Profile
    match /business/{bizId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
