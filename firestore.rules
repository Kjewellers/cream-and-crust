rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ======================================================
    // STRICT HELPER FUNCTIONS
    // ======================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    function isCreatingAsOwner() {
      return isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    function validString(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    function validNumber(field, minVal, maxVal) {
      return field is number && field >= minVal && field <= maxVal;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ======================================================
    // USERS (Admin / Bakers)
    // ======================================================
    match /users/{userId} {
      allow read:            if isAuthenticated() && request.auth.uid == userId;
      // Allow create if auth matches, but prevent overwriting existing user data maliciously
      allow create:          if isAuthenticated() && request.auth.uid == userId;
      allow update:          if isAuthenticated() && request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid']));
      allow delete:          if false; // Strict: Users cannot delete their own root doc directly without cloud function
    }

    // ======================================================
    // BUSINESS PROFILE
    // Public read. Owner write.
    // ======================================================
    match /business/{bizId} {
      allow read:  if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if false; // Strict: Business profiles shouldn't be deleted by client
    }

    // ======================================================
    // PRODUCTS (Catalog)
    // ======================================================
    match /products/{productId} {
      allow read: if true;
      allow create: if isCreatingAsOwner()
                    && validString(request.resource.data.name, 1, 200);
      allow update: if isDocOwner()
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid'])); // Prevent changing ownership
      allow delete: if isDocOwner();
    }

    // ======================================================
    // ORDERS
    // ======================================================
    match /orders/{orderId} {
      // Owner (bakery) can fully manage their own orders
      allow create: if isCreatingAsOwner()
                    && request.resource.data.keys().hasAll(['uid', 'createdAt'])
                    && validString(request.resource.data.uid, 1, 100);
      // Anonymous customers placing an order from a published menu may
      // create a single order doc routed to a specific bakery. The doc
      // must be tagged channel='website' (so only this flow can use it),
      // include a small set of customer-facing fields, and target an
      // existing public business profile.
      allow create: if request.resource.data.channel == 'website'
                    && request.resource.data.keys().hasAll(['uid', 'createdAt', 'channel'])
                    && validString(request.resource.data.uid, 1, 100)
                    && exists(/databases/$(database)/documents/business/$(request.resource.data.uid));
      allow read:            if isDocOwner();
      allow update:          if isDocOwner() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid'])); // Lock ownership
      allow delete:          if isDocOwner();
    }

    // ======================================================
    // CUSTOMERS (Encrypted PII)
    // ======================================================
    match /customers/{customerId} {
      allow read, delete: if isDocOwner();
      allow create:       if isCreatingAsOwner() && hasRequiredFields(['uid']);
      allow update:       if isDocOwner() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']));
    }

    // ======================================================
    // INVENTORY
    // ======================================================
    match /inventory/{itemId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingAsOwner()
                    && hasRequiredFields(['uid']);
      allow update: if isDocOwner() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']));
    }

    // ======================================================
    // RECIPES
    // ======================================================
    match /recipes/{recipeId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingAsOwner()
                    && hasRequiredFields(['uid']);
      allow update: if isDocOwner() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']));
    }

    // ======================================================
    // EXPENSES
    // ======================================================
    match /expenses/{expenseId} {
      allow read, delete: if isDocOwner();
      allow create: if isCreatingAsOwner()
                    && hasRequiredFields(['uid']);
      allow update: if isDocOwner() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']));
    }

    // ======================================================
    // SHOPPING LIST
    // ======================================================
    match /shoppingList/{itemId} {
      allow read, delete: if isDocOwner();
      allow create:       if isCreatingAsOwner();
      allow update:       if isDocOwner() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']));
    }

    // ======================================================
    // INQUIRIES
    // ======================================================
    match /inquiries/{inqId} {
      // Owner-self creation (in-app form on baker's own dashboard)
      allow create: if isAuthenticated() && request.resource.data.keys().hasAll(['uid', 'createdAt']);
      // Public website / WhatsApp / Instagram channel — customer creates
      // an inquiry that targets a bakery. The doc must be tagged channel
      // and route to an existing public business profile.
      allow create: if request.resource.data.channel in ['website', 'whatsapp', 'instagram']
                    && request.resource.data.keys().hasAll(['uid', 'createdAt', 'channel'])
                    && exists(/databases/$(database)/documents/business/$(request.resource.data.uid));
      allow read, update, delete: if isDocOwner();
    }
    
    // ======================================================
    // NOTIFICATIONS
    // ======================================================
    match /notifications/{notifId} {
      allow read, delete: if isDocOwner();
      // Owner self-creates (in-app actions on baker's dashboard)
      allow create:       if isCreatingAsOwner();
      // Public website / WhatsApp / Instagram channel — customer event
      // pings the bakery. Doc must be tagged channel and route to an
      // existing public business profile.
      allow create:       if request.resource.data.channel in ['website', 'whatsapp', 'instagram']
                          && request.resource.data.keys().hasAll(['uid', 'channel'])
                          && exists(/databases/$(database)/documents/business/$(request.resource.data.uid));
      allow update:       if isDocOwner();
    }

    // ======================================================
    // STORIES
    // ======================================================
    match /stories/{storyId} {
      allow read: if true;
      allow create:           if isCreatingAsOwner();
      allow update, delete:   if isDocOwner();
    }

    match /subscriptions/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ======================================================
    // USER CAPTURES (owner-scoped)
    // ======================================================
    match /userCaptures/{captureId} {
      allow read, delete: if isDocOwner();
      allow create:       if isCreatingAsOwner();
      allow update:       if isDocOwner() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']));
    }

    // ======================================================
    // MENU ANALYTICS — Event Tracking
    // ======================================================
    match /analytics_events/{eventId} {
      // Anyone can create an event (visitors on public menus)
      // Must contain a valid bakeryId mapping to a business
      allow create: if request.resource.data.keys().hasAll(['bakeryId', 'eventType', 'timestamp'])
                    && validString(request.resource.data.bakeryId, 1, 100)
                    && exists(/databases/$(database)/documents/business/$(request.resource.data.bakeryId));
      // Only the bakery owner can read/delete their own events
      allow read, delete: if isAuthenticated() && resource.data.bakeryId == request.auth.uid;
      allow update: if false;
    }

    // ======================================================
    // MENU ANALYTICS — Aggregation Collections
    // Only Cloud Functions write. Bakery owners read their own.
    // ======================================================
    match /analytics_summary/{bakeryId} {
      allow read: if isAuthenticated() && request.auth.uid == bakeryId;
      allow create, update, delete: if false; // Cloud Functions only
    }

    match /analytics_products/{docId} {
      allow read: if isAuthenticated() && resource.data.bakeryId == request.auth.uid;
      allow create, update, delete: if false; // Cloud Functions only
    }

    match /analytics_peak_hours/{bakeryId} {
      allow read: if isAuthenticated() && request.auth.uid == bakeryId;
      allow create, update, delete: if false; // Cloud Functions only
    }

    match /analytics_cities/{docId} {
      allow read: if isAuthenticated() && resource.data.bakeryId == request.auth.uid;
      allow create, update, delete: if false; // Cloud Functions only
    }

    match /analytics_sources/{bakeryId} {
      allow read: if isAuthenticated() && request.auth.uid == bakeryId;
      allow create, update, delete: if false; // Cloud Functions only
    }

    match /analytics_customers/{bakeryId} {
      allow read: if isAuthenticated() && request.auth.uid == bakeryId;
      allow create, update, delete: if false; // Cloud Functions only
    }

    match /analytics_daily/{docId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false; // Cloud Functions only
    }

    // ======================================================
    // STRICT BLOCK
    // ======================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
