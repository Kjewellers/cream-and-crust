# ──────────────────────────────────────────────────────────────
# Cream & Crust — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file — it is already in .gitignore.
# ──────────────────────────────────────────────────────────────

# Firebase
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxx

# API
VITE_API_URL=/api

# Cloudinary (image uploads)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# ⚠️ Encryption key — CRITICAL
# Generate with: openssl rand -hex 16
# Must be IDENTICAL in .env AND Vercel env vars.
# Changing this will make ALL existing encrypted data UNRECOVERABLE.
VITE_CRYPTO_KEY=generate-a-random-32-char-hex-key

# Firebase App Check — reCAPTCHA v3
# Get from: https://console.cloud.google.com/security/recaptcha
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
